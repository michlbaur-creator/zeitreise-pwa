diff --git a/App/app/globals.css b/App/app/globals.css
index c7884cc..08c9a87 100644
--- a/App/app/globals.css
+++ b/App/app/globals.css
@@ -11688,3 +11688,293 @@ body.cinematic-intro-active {
     margin-inline: auto;
   }
 }
+
+/* Episode 3 – technische Vorschau für Teil 1 */
+.ep3-shell {
+  --ep3-gold: #e7c27f;
+  --ep3-earth: #9f7450;
+  --ep3-sage: #879d78;
+}
+
+.ep3-back-link {
+  text-decoration: none;
+}
+
+.ep3-preview-badge {
+  display: inline-flex;
+  margin: 4px 0 5px;
+  padding: 5px 9px;
+  border: 1px solid rgba(231, 194, 127, 0.3);
+  border-radius: 999px;
+  color: var(--ep3-gold);
+  font-size: 0.65rem;
+  font-weight: 800;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.ep3-preview-lead {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  align-items: end;
+  gap: 30px;
+  margin: 30px 0 42px;
+  padding: clamp(24px, 4vw, 44px);
+  border: 1px solid var(--line);
+  border-radius: 22px;
+  background:
+    radial-gradient(circle at 85% 18%, rgba(187, 130, 75, 0.14), transparent 28%),
+    linear-gradient(145deg, rgba(29, 43, 38, 0.96), rgba(15, 23, 21, 0.96));
+  box-shadow: var(--shadow);
+}
+
+.ep3-preview-lead h2,
+.ep3-editorial-note h2 {
+  margin: 4px 0 12px;
+  font-family: "Iowan Old Style", Georgia, serif;
+  font-weight: 500;
+}
+
+.ep3-preview-lead h2 {
+  font-size: clamp(2rem, 5vw, 3.6rem);
+  line-height: 1.02;
+}
+
+.ep3-preview-lead > div:first-child > p:last-child {
+  max-width: 780px;
+  margin: 0;
+  color: var(--muted);
+  line-height: 1.65;
+}
+
+.ep3-progress {
+  display: grid;
+  place-items: center;
+  min-width: 150px;
+  aspect-ratio: 1;
+  border: 1px solid rgba(231, 194, 127, 0.28);
+  border-radius: 50%;
+  background: rgba(231, 194, 127, 0.06);
+}
+
+.ep3-progress strong {
+  align-self: end;
+  color: var(--ep3-gold);
+  font-family: "Iowan Old Style", Georgia, serif;
+  font-size: 2.5rem;
+  font-weight: 500;
+}
+
+.ep3-progress span {
+  align-self: start;
+  max-width: 90px;
+  color: var(--muted);
+  font-size: 0.7rem;
+  line-height: 1.3;
+  text-align: center;
+  text-transform: uppercase;
+}
+
+.ep3-scene-preview {
+  padding: clamp(18px, 3vw, 30px);
+  border: 1px solid var(--line);
+  border-radius: 22px;
+  background: rgba(18, 28, 25, 0.9);
+  box-shadow: var(--shadow);
+}
+
+.ep3-scene-heading {
+  margin-bottom: 20px;
+}
+
+.ep3-time-transition {
+  position: relative;
+  overflow: hidden;
+  min-height: 0;
+  aspect-ratio: 16 / 9;
+  border: 1px solid rgba(255, 255, 255, 0.12);
+  border-radius: 16px;
+  background: #161d1a;
+  isolation: isolate;
+}
+
+.ep3-time-transition::after {
+  position: absolute;
+  z-index: 3;
+  inset: 0;
+  background: linear-gradient(180deg, transparent 52%, rgba(5, 9, 8, 0.72));
+  content: "";
+  pointer-events: none;
+}
+
+.ep3-time-image {
+  position: absolute;
+  inset: 0;
+  background-position: center;
+  background-size: cover;
+  transition: opacity 1.8s ease, filter 1.8s ease, transform 8s ease;
+}
+
+.ep3-time-image-present {
+  z-index: 1;
+}
+
+.ep3-time-image-past {
+  z-index: 2;
+  opacity: 0;
+  filter: saturate(0.8) brightness(0.92);
+}
+
+.ep3-time-transition.shows-past .ep3-time-image-present {
+  transform: scale(1.025);
+}
+
+.ep3-time-transition.shows-past .ep3-time-image-past {
+  opacity: 1;
+  filter: saturate(0.95) brightness(1);
+  transform: scale(1.025);
+}
+
+.ep3-time-caption {
+  position: absolute;
+  z-index: 4;
+  left: clamp(18px, 4vw, 42px);
+  bottom: clamp(18px, 4vw, 38px);
+}
+
+.ep3-time-caption span,
+.ep3-time-caption strong {
+  display: block;
+  text-shadow: 0 2px 18px rgba(0, 0, 0, 0.72);
+}
+
+.ep3-time-caption span {
+  color: var(--ep3-gold);
+  font-size: 0.72rem;
+  font-weight: 800;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+}
+
+.ep3-time-caption strong {
+  margin-top: 5px;
+  font-family: "Iowan Old Style", Georgia, serif;
+  font-size: clamp(1.25rem, 3vw, 2.2rem);
+  font-weight: 500;
+}
+
+.ep3-transition-controls {
+  display: flex;
+  justify-content: center;
+  gap: 10px;
+  padding-top: 18px;
+}
+
+.ep3-transition-controls button {
+  padding: 11px 16px;
+  border: 1px solid var(--line-strong);
+  border-radius: 999px;
+  background: transparent;
+  color: var(--muted);
+  cursor: pointer;
+}
+
+.ep3-transition-controls button.is-active {
+  border-color: rgba(231, 194, 127, 0.55);
+  background: rgba(231, 194, 127, 0.12);
+  color: var(--ink);
+}
+
+.ep3-next-draft {
+  display: grid;
+  grid-template-columns: minmax(0, 1.55fr) minmax(280px, 0.7fr);
+  overflow: hidden;
+  margin-top: 42px;
+  border: 1px solid rgba(231, 194, 127, 0.2);
+  border-radius: 22px;
+  background: rgba(18, 28, 25, 0.88);
+}
+
+.ep3-next-draft-image {
+  min-height: 390px;
+  background-position: center;
+  background-size: cover;
+}
+
+.ep3-next-draft-copy {
+  display: flex;
+  justify-content: center;
+  flex-direction: column;
+  padding: clamp(26px, 4vw, 46px);
+}
+
+.ep3-next-draft-copy h2 {
+  margin: 5px 0 13px;
+  font-family: "Iowan Old Style", Georgia, serif;
+  font-size: clamp(1.8rem, 3.2vw, 2.8rem);
+  font-weight: 500;
+}
+
+.ep3-next-draft-copy > p:not(.eyebrow) {
+  margin: 0;
+  color: var(--muted);
+  line-height: 1.6;
+}
+
+.ep3-next-draft-copy > span {
+  align-self: flex-start;
+  margin-top: 22px;
+  padding: 6px 9px;
+  border: 1px solid rgba(231, 194, 127, 0.28);
+  border-radius: 999px;
+  color: var(--ep3-gold);
+  font-size: 0.64rem;
+  font-weight: 800;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.ep3-editorial-note {
+  max-width: 820px;
+  margin: 42px auto 0;
+  padding: 24px 28px;
+  border-left: 3px solid var(--ep3-earth);
+  background: rgba(159, 116, 80, 0.06);
+}
+
+.ep3-editorial-note p:last-child {
+  margin-bottom: 0;
+  color: var(--muted);
+  line-height: 1.6;
+}
+
+@media (max-width: 680px) {
+  .ep3-header {
+    align-items: flex-start;
+  }
+
+  .ep3-preview-lead,
+  .ep3-next-draft {
+    grid-template-columns: 1fr;
+  }
+
+  .ep3-next-draft-image {
+    min-height: 0;
+    aspect-ratio: 16 / 9;
+  }
+
+  .ep3-progress {
+    min-width: 0;
+    width: 116px;
+  }
+  .ep3-transition-controls {
+    align-items: stretch;
+    flex-direction: column;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .ep3-time-image {
+    transition-duration: 1ms;
+  }
+}
